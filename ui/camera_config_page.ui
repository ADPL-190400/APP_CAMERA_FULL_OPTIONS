                    </property>
                   </widget>
                  </item>
                  <item row="2" column="1">
                   <widget class="QComboBox" name="combo_inference_quality">
                    <property name="toolTip">
                     <string>Image size fed into the AI model (pose/PPE/fire/fall) - does not affect the display resolution. Fast/Balanced run much smoother when AI runs on multiple cameras at once, at the cost of slightly lower accuracy for small or distant people/objects.</string>
                    </property>
                    <item>
                     <property name="text">
                      <string>Fast (320px)</string>
                     </property>
                    </item>
                    <item>
                     <property name="text">
